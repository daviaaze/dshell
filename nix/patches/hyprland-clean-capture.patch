+
+bool Render::isPrivateCaptureAppID(std::string_view appID) {
+    const auto equals = [appID](std::string_view expected) {
+        if (appID.size() != expected.size())
+            return false;
+        for (size_t i = 0; i < appID.size(); ++i) {
+            const char c = appID[i] >= 'A' && appID[i] <= 'Z' ? appID[i] + ('a' - 'A') : appID[i];
+            if (c != expected[i])
+                return false;
+        }
+        return true;
+    };
+    return equals("bitwarden") || equals("com.bitwarden.desktop");
+}
+
+bool Render::isPrivateCaptureNamespace(std::string_view name) {
+    // The launcher owns clipboard history in every mode, including transitions.
+    return name == "shade-recording-boundary" || name == "shade-launcher";
+}
+
+bool Render::isWindowCapturePrivate(PHLWINDOW window) {
+    if (!window)
+        return true;
+
+    // Ancestry is client-controlled. Bound traversal without allocating a visited set.
+    size_t remaining = Desktop::windowState()->windows().size() + 1;
+    while (window && remaining-- > 0) {
+        if (!window->m_workspace || !window->m_ruleApplicator || window->onSpecialWorkspace() || window->m_ruleApplicator->noScreenShare().valueOrDefault() ||
+            isPrivateCaptureAppID(window->metadata().appID()) || isPrivateCaptureAppID(window->metadata().initialAppID()))
+            return true;
+
+        const auto PARENT = window->backend().parent();
+        // Orphaned transients and unowned X11 override-redirect surfaces cannot be proven public.
+        if (!PARENT)
+            return window->backend().traits().transient || window->backend().traits().overrideRedirect;
+        window = PARENT;
+    }
+    return true;
+}
+
+bool Render::isLayerCapturePrivate(PHLLS layer) {
+    return !layer || !layer->m_ruleApplicator || isPrivateCaptureNamespace(layer->m_namespace) || layer->m_ruleApplicator->noScreenShare().valueOrDefault();
+}
+
+bool Render::captureOmitsFullscreen(PHLWORKSPACE workspace) {
+    const auto FULLSCREEN = workspace ? Fullscreen::controller()->getFullscreenWindow(workspace) : nullptr;
+    return FULLSCREEN && isWindowCapturePrivate(FULLSCREEN);
+}
+
+bool Render::isCursorCaptureSafe() {
+    if (!g_pSessionLockManager || g_pSessionLockManager->isSessionLocked() || Pointer::mgr()->hasTransformers())
+        return false;
+
+    const auto& IMAGE = Pointer::mgr()->currentCursorImage();
+    if (!IMAGE.surface)
+        return true; // Compositor-owned theme buffers contain no client surface pixels.
+
+    const auto FOCUS = CWLSurface::fromResource(g_pSeatManager->m_state.pointerFocus.lock());
+    if (!FOCUS || !FOCUS->resource() || !IMAGE.surface->resource() || FOCUS->resource()->client() != IMAGE.surface->resource()->client())
+        return false;
+
+    // Require both the owner recorded at set_cursor and the current owner. Unknown
+    // popup/subsurface ownership fails closed instead of trusting the current focus alone.
+    if (const auto WINDOW = IMAGE.captureWindowOwner.lock(); WINDOW)
+        return WINDOW == CWindow::fromView(FOCUS->view()) && !isWindowCapturePrivate(WINDOW);
+    if (const auto LAYER = IMAGE.captureLayerOwner.lock(); LAYER)
+        return LAYER == CLayerSurface::fromView(FOCUS->view()) && !isLayerCapturePrivate(LAYER);
+    return false;
+}
