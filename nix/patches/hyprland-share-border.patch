+bool CScreenshareManager::hasPendingCapture(const CScreenshareSession* session) const {
+    return std::ranges::any_of(m_pendingFrames, [session](const auto& frame) {
+        return frame && frame->m_session.get() == session && frame->m_shared && !frame->done();
+    });
+}
+
+void CScreenshareManager::renderShareBorders(Render::CRenderContext& ctx) {
+    const auto MONITOR = ctx.m_data.pMonitor.lock();
+    if (!MONITOR || g_pSessionLockManager->isSessionLocked() || MONITOR->m_dpmsBlackOpacity->value() != 0.F)
+        return;
+
+    const CBox bounds = {{}, MONITOR->m_transformedSize};
+    const CHyprColor color(1.0, 0.12, 0.12, 1.0);
+    const double thickness = 2.0 * MONITOR->m_scale;
+    const auto drawEdge = [&](CBox edge) {
+        edge = edge.intersection(bounds);
+        if (!edge.empty())
+            Render::GL::g_pHyprOpenGL->renderRect(ctx, edge, color, {});
+    };
+
+    for (const auto& session : m_sessions) {
+        if (!session || session->m_stopped || !session->m_borderVisible)
+            continue;
+
+        CBox box;
+        switch (session->m_type) {
+            case SHARE_MONITOR:
+                if (session->monitor() != MONITOR)
+                    continue;
+                box = bounds;
+                break;
+            case SHARE_REGION:
+                if (session->monitor() != MONITOR)
+                    continue;
+                box = session->m_captureBox;
+                break;
+            case SHARE_WINDOW:
+                if (!session->m_window || !g_pHyprRenderer->shouldRenderWindow(session->m_window.lock(), MONITOR))
+                    continue;
+                box = session->m_window->geometricBox(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+                box.translate(-MONITOR->m_position).scale(MONITOR->m_scale);
+                break;
+            default:
+                continue;
+        }
+        if (box.w <= 0 || box.h <= 0)
+            continue;
+        const double t = std::min(thickness, std::min(box.w, box.h) / 2.0);
+        drawEdge({box.x, box.y, box.w, t});
+        drawEdge({box.x, box.y + box.h - t, box.w, t});
+        drawEdge({box.x, box.y + t, t, box.h - 2 * t});
+        drawEdge({box.x + box.w - t, box.y + t, t, box.h - 2 * t});
+    }
+}
