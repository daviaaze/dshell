+TEST_F(CWorkspaceCaptureFrameTest, DirectPrivateWindowSourcesAreRejectedWithoutSubstitution) {
+    auto window = makeSnapshotTestWindow(m_workspace);
+    window->sizeAnimation()->setValueAndWarp({80, 60});
+    window->m_ruleApplicator->noScreenShare().set(true, Desktop::Types::PRIORITY_SET_PROP);
+    EXPECT_FALSE(Screenshare::mgr()->newSession(m_client, window));
+    EXPECT_FALSE(Screenshare::mgr()->getManagedSession(m_client, window));
+    window->m_ruleApplicator->noScreenShare().unset(Desktop::Types::PRIORITY_SET_PROP);
+    auto session = Screenshare::mgr()->newSession(m_client, window);
+    ASSERT_TRUE(session);
+    auto frame = session->nextFrame(false);
+    window->m_ruleApplicator->noScreenShare().set(true, Desktop::Types::PRIORITY_SET_PROP);
+    EXPECT_EQ(frame->share(buffer(session->bufferSize()), {}, [](auto) { ; }), Screenshare::ERROR_STOPPED);
+    EXPECT_TRUE(frame->done());
+}
+
+TEST_F(CWorkspaceCaptureFrameTest, DirectSpecialWorkspaceSourcesAreRejectedWithoutSubstitution) {
+    auto workspace = makeShared<CSessionTestWorkspace>(m_monitor, Workspace::eWorkspaceType::SPECIAL);
+    workspace->m_self = workspace;
+    auto special = makeShared<Screenshare::CWorkspaceCaptureSource>(workspace, HYPRLAND_WORKSPACE_IMAGE_CAPTURE_SOURCE_MANAGER_V1_CAPTURE_MODE_EVERYTHING);
+    EXPECT_FALSE(Screenshare::mgr()->newSession(m_client, special));
+    EXPECT_FALSE(Screenshare::mgr()->getManagedSession(m_client, special));
+}
