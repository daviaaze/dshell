+TEST_F(CWorkspaceCaptureSceneTest, DirectWindowCapturePacesOnlyOffWorkspaceFrameCallbacks) {
+    auto window = makeSnapshotTestWindow(m_workspace);
+    window->sizeAnimation()->setValueAndWarp({80, 60});
+    auto session = Screenshare::mgr()->newSession(m_client, window);
+    ASSERT_TRUE(session);
+    for (const bool dma : {false, true}) {
+        for (const bool visible : {true, false}) {
+            SCOPED_TRACE(dma);
+            SCOPED_TRACE(visible);
+            m_workspace->setVisible(visible);
+            auto surf = surface({80, 60});
+            window->wlSurface()->assign(surf, window);
+            auto feedback = makeShared<CPresentationFeedback>(makeUnique<CWpPresentationFeedback>(m_client, 2, m_nextID++), surf);
+            ASSERT_TRUE(feedback->good());
+            surf->m_current.presentationFeedbacks.emplace_back(feedback);
+            ASSERT_EQ(g_pHyprRenderer->shouldRenderWindow(window), visible);
+            capture(*session, dma);
+            EXPECT_EQ(surf->m_current.callbacks.size(), visible ? 1U : 0U);
+            ASSERT_EQ(surf->m_current.presentationFeedbacks.size(), 1U);
+            EXPECT_EQ(surf->m_current.presentationFeedbacks.front(), feedback);
+            EXPECT_FALSE(PROTO::presentation->hasPendingFeedbacks());
+            EXPECT_EQ(window->m_workspace, m_workspace);
+            EXPECT_EQ(m_workspace->visible(), visible);
+            window->wlSurface()->unassign();
+        }
+    }
+}
