+    launcher->m_namespace = "shade-launcher";
+    boundary->m_namespace = "shade-recording-boundary";
+    auto session = Screenshare::mgr()->newSession(m_client, source(HYPRLAND_WORKSPACE_IMAGE_CAPTURE_SOURCE_MANAGER_V1_CAPTURE_MODE_EVERYTHING));
+    ASSERT_TRUE(session);
+    for (const bool dma : {false, true}) {
+        capture(*session, dma);
+        EXPECT_EQ(drawnSurfaces(), (std::vector<WP<CWLSurfaceResource>>{publicLayer->resource()}));
+        expectUnpaced(launcher->resource());
+        expectUnpaced(boundary->resource());
+    }
+}
