+TEST(CapturePrivacy, BitwardenIdentifiersAreExactAndCaseInsensitive) {
+    for (const auto id : {"bitwarden", "Bitwarden", "BITWARDEN", "com.bitwarden.desktop", "COM.BITWARDEN.DESKTOP"})
