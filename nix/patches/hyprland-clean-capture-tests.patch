+TEST(CapturePrivacy, PrivateShellNamespacesDoNotDependOnDynamicRules) {
+    EXPECT_TRUE(isPrivateCaptureNamespace("shade-recording-boundary"));
+    EXPECT_TRUE(isPrivateCaptureNamespace("shade-launcher"));
+    EXPECT_FALSE(isPrivateCaptureNamespace("shade-recording-bar"));
+    EXPECT_FALSE(isPrivateCaptureNamespace("shade-launcher-preview"));
+    EXPECT_FALSE(isPrivateCaptureNamespace("other-shade-launcher"));
+}
