+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{sync::mpsc, thread, time::Duration};
+
+    #[test]
+    fn pending_worker_receive_does_not_block_cancellation() {
+        let (parent, child) = worker_socket_pair().unwrap();
+        child.send(b"ready").unwrap();
+        let (completed, completion) = mpsc::channel();
+        let worker = thread::spawn(move || {
+            let runtime = tokio::runtime::Builder::new_current_thread()
+                .enable_all()
+                .build()
+                .unwrap();
+            runtime.block_on(async move {
+                let socket = TokioUnixDatagram::from_std(parent).unwrap();
+                let mut buffer = [0; 16];
+                socket.recv(&mut buffer).await.unwrap();
+                let (cancel, mut cancelled) = watch::channel(false);
+                tokio::spawn(async move {
+                    tokio::time::sleep(Duration::from_millis(20)).await;
+                    cancel.send_replace(true);
+                });
+                let was_cancelled = tokio::select! {
+                    _ = cancelled.changed() => true,
+                    _ = socket.recv(&mut buffer) => false,
+                };
+                completed.send(was_cancelled).unwrap();
+            });
+        });
+        let result = completion.recv_timeout(Duration::from_secs(5));
+        // Also release a regressed blocking receive so a failed test leaves no hung thread.
+        let _ = child.send(b"release");
+        let joined = worker.join();
+        assert!(joined.is_ok(), "worker I/O test thread panicked");
+        assert!(matches!(result, Ok(true)), "worker receive starved cancellation");
+    }
+}
