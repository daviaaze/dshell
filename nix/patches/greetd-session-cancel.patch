+fn worker_socket_pair() -> Result<(UnixDatagram, UnixDatagram), Error> {
+    let (parent, child) =
+        UnixDatagram::pair().map_err(|error| format!("could not create pipe: {}", error))?;
+    // Tokio requires nonblocking I/O; the worker endpoint must remain blocking.
+    parent.set_nonblocking(true)?;
+    Ok((parent, child))
+}
+
+fn open_pidfd(task: Pid) -> Result<Arc<OwnedFd>, Error> {
+    let fd = unsafe { libc::syscall(libc::SYS_pidfd_open, task.as_raw(), 0) };
+    if fd < 0 {
+        return Err(std::io::Error::last_os_error().into());
+    }
+    Ok(Arc::new(unsafe { OwnedFd::from_raw_fd(fd as _) }))
+}
+
+/// Cancel only this worker, never a later process which reused its PID.
+#[derive(Clone)]
+pub struct SessionCanceller {
+    pidfd: Arc<OwnedFd>,
+    cancelled: watch::Sender<bool>,
+}
+
+impl SessionCanceller {
+    pub fn cancel(&self) -> Result<(), Error> {
+        self.cancelled.send_replace(true);
+        let result = unsafe {
+            libc::syscall(
+                libc::SYS_pidfd_send_signal,
+                self.pidfd.as_raw_fd(),
+                libc::SIGKILL,
+                std::ptr::null::<libc::siginfo_t>(),
+                0,
+            )
+        };
+        if result < 0 {
+            let error = std::io::Error::last_os_error();
+            if error.raw_os_error() != Some(libc::ESRCH) {
+                return Err(error.into());
+            }
+        }
+        Ok(())
+    }
+}
