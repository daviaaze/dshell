{
  "name": "shade-shell",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "types": "npx @ts-for-gir/cli generate -o @girs --ignoreVersionConflicts",
    "check": "tsc --noEmit",
    "check:all": "pnpm run types && pnpm run lint && pnpm run check",
    "test": "node -e \"require('esbuild').buildSync({entryPoints:['src/lib/__tests__/hypridle.test.ts'],bundle:true,outfile:'build/test/hypridle.test.js',format:'esm',external:['gi://*'],alias:{'#':'./src'},target:'es2020'})\" && nix develop -c gjs -m build/test/hypridle.test.js",
    "test:compile": "node -e \"require('esbuild').buildSync({entryPoints:['src/lib/__tests__/hypridle.test.ts'],bundle:true,outfile:'build/test/hypridle.test.js',format:'esm',external:['gi://*'],alias:{'#':'./src'},target:'es2020'})\"",
    "preview": "node tools/preview.mjs",
    "preview:dev": "node tools/preview.mjs --watch",
    "build": "meson setup build --wipe && meson compile -C build",
    "dev": "nix run . --",
    "syntax": "mkdir -p /tmp/esbuild-check && esbuild src/main.ts --bundle --format=esm --external:gi://* --external:resource://* --external:system --external:gettext --external:gnim --external:gnim/* --external:gnim-schemas --outdir=/tmp/esbuild-check && rm -rf /tmp/esbuild-check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@girs/adw-1": "^1.10.0-4.0.4",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "dependencies": {
    "gnim": "1.9.1",
    "gnim-schemas": "^0.3.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "bracketSpacing": false,
    "arrowParens": "avoid",
    "quoteProps": "as-needed"
  }
}