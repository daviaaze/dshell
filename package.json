{
  "name": "shade-shell",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "lint": "eslint . --fix",
    "format": "prettier --write \"{packages,apps}/*/src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"{packages,apps}/*/src/**/*.{ts,tsx,css,json}\"",
    "types": "gnim types --alias",
    "check": "tsc --noEmit",
    "check:all": "pnpm run types && pnpm run lint && pnpm run check && pnpm run deps:check && pnpm run test",
    "deps:graph": "bash scripts/deps-graph.sh",
    "deps:check": "OUT_DIR=$(mktemp -d) bash scripts/deps-graph.sh",
    "test": "nix develop -c bash scripts/test.sh",
    "build": "nix build",
    "dev": "bash scripts/dev.sh",
    "syntax": "mkdir -p /tmp/esbuild-check && esbuild apps/shell/src/main.ts --bundle --format=esm --external:gi://* --external:resource://* --external:system --external:gettext --external:gnim --external:gnim/* --external:gnim-schemas --outdir=/tmp/esbuild-check && rm -rf /tmp/esbuild-check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@gnim-js/gtk4": "2.0.0-beta.7",
    "gnim": "2.0.0-beta.7"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "bracketSpacing": false,
    "arrowParens": "avoid",
    "quoteProps": "as-needed"
  }
}
