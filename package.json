{
    "name": "shade-shell",
    "version": "0.2.1",
    "type": "module",
    "scripts": {
        "lint": "biome check --write",
        "format": "biome format --write",
        "format:check": "biome format --check",
        "types": "gnim types --alias",
        "check": "tsc --noEmit",
        "check:all": "pnpm run types && pnpm run lint && pnpm run check && pnpm run deps:check && pnpm run test",
        "deps:graph": "bash scripts/deps-graph.sh",
        "deps:check": "OUT_DIR=$(mktemp -d) bash scripts/deps-graph.sh",
        "test": "nix develop -c bash scripts/test.sh",
        "build": "nix build",
        "dev": "bash scripts/dev.sh",
        "syntax": "mkdir -p /tmp/esbuild-check && esbuild apps/shell/src/main.ts --bundle --format=esm --external:gi://* --external:resource://* --external:system --external:gettext --external:gnim --external:gnim/* --external:gnim-schemas --outdir=/tmp/esbuild-check && rm -rf /tmp/esbuild-check"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "esbuild": "^0.28.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@gnim-js/gtk4": "2.0.0-beta.7",
        "gnim": "2.0.0-beta.7"
    }
}
