{
  "name": "shade-shell",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "lint": "eslint . --fix",
    "types": "npx @ts-for-gir/cli generate -o @girs --ignoreVersionConflicts",
    "build": "meson setup build --wipe && meson compile -C build",
    "dev": "nix run . --"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@girs/adw-1": "latest",
    "esbuild": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  },
  "dependencies": {
    "gnim": "^1.9.1",
    "gnim-schemas": "^0.3.0"
  },
  "prettier": {
    "semi": false
  }
}