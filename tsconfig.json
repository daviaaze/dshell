{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "lib": ["ES2024"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "paths": { "#/*": ["./src/*"] },
    "jsx": "react-jsx",
    "jsxImportSource": "gnim/gtk4",
  },
  "exclude": ["build", "src/previewer"],
}
